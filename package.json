{
	"name": "@agritheory/approvals",
	"private": true,
	"type": "module",
	"release": {
		"branches": [
			"version-15"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/approvals.git"
	},
	"scripts": {
		"postinstall": "npm install --prefix node_modules/@agritheory/flyin && npm run build --prefix node_modules/@agritheory/flyin",
		"build": "vite build --config=./approvals/public/js/vite.config.ts && node node_modules/@agritheory/flyin/dist/cli/build-if-host.js",
		"build:flyin": "node node_modules/@agritheory/flyin/dist/cli/build-if-host.js",
		"dev": "vite build --watch --config=./approvals/public/js/vite.config.ts"
	},
	"dependencies": {
		"@agritheory/flyin": "git+https://github.com/agritheory/flyin.git#v15.0.0",
		"vue": "^3.5.14"
	},
	"devDependencies": {
		"@types/node": "^20.17.50",
		"@vitejs/plugin-vue": "^5.2.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.5"
	},
	"publishConfig": {
		"access": "restricted"
	}
}
